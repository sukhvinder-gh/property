# Supabase (server) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (chatbot)
ANTHROPIC_API_KEY=

# Google Places API (New) — server-only key for address autocomplete.
# Enable "Places API (New)" in Google Cloud Console; no browser key needed,
# the app proxies requests through /api/places-autocomplete.
GOOGLE_PLACES_API_KEY=

# Inngest (background pipeline; optional for local dev without the Inngest CLI)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Data source: live NSW Planning Portal/Spatial Services by default.
# Set true to use the curated demo fixtures instead (offline dev, or to
# showcase the profiled-council scoring path with richer mock data).
USE_MOCK_DATA_SOURCE=false
